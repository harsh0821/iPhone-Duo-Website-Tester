{
  "rewrites": [
    { "source": "/__proxy/(.*)", "destination": "/api/proxy?__path=$1" },
    {
      "source": "/:path((?!api/|__proxy/|assets/|sw\\.js).*)",
      "has": [{ "type": "header", "key": "sec-fetch-dest", "value": "iframe" }],
      "destination": "/api/proxy?__fallback=:path"
    }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
